        <div class="card h-96 overflow-y-auto">
            <h3 class="text-lg font-bold mb-4 sticky top-0 bg-[#1e293b] py-2">AI BRAIN LOGS</h3>
            <div id="ai-logs" class="space-y-3 text-sm font-mono"></div>
        </div>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="card h-64 overflow-y-auto">
            <h3 class="text-lg font-bold mb-4 sticky top-0 bg-[#1e293b]">TRADE HISTORY</h3>
            <table class="w-full">
                <thead><tr><th>TIME</th><th>PAIR</th><th>SIDE</th><th>PRICE</th></tr></thead>
                <tbody id="trades-body"></tbody>
            </table>
        </div>
        
        <div class="card">
            <h3 class="text-lg font-bold mb-4 flex justify-between">
                <span>AI PROMPT EDITOR</span>
                <span id="prompt-target" class="text-xs text-blue-400 font-mono self-center"></span>
            </h3>
            <textarea id="prompt-text" class="w-full h-32 bg-slate-900 border border-slate-600 rounded p-2 text-xs font-mono mb-2" placeholder="Select a bot filter (Crypto/Stocks) to edit its instructions..."></textarea>
            <div class="flex justify-end space-x-2">
                <button onclick="loadConfig()" class="btn btn-slate text-xs">RELOAD</button>
                <button onclick="saveConfig()" id="btn-save-prompt" class="btn btn-blue text-xs">SAVE PROMPT</button>
            </div>
        </div>
    </div>

    <script>
        let currentFilter = 'all';
        let cachedPrompts = {};
        const TOKEN_KEY = "trading_admin_token";
        
        document.getElementById('token-input').value = localStorage.getItem(TOKEN_KEY) || "";

        function saveToken() { localStorage.setItem(TOKEN_KEY, document.getElementById('token-input').value.trim()); alert("Saved"); fetchData(); }
        function getAuthHeader() { const t = localStorage.getItem(TOKEN_KEY); return t ? { "Authorization": "Bearer " + t } : {}; }

        async function apiCall(path, body=null) {
            const opts = { method: 'POST', headers: { ...getAuthHeader(), 'Content-Type': 'application/json' } };
            if (body) opts.body = JSON.stringify(body);
            try { await fetch(path, opts); fetchData(); } catch(e) { console.error(e); }
        }

        function setFilter(type) {
            currentFilter = type;
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
            document.getElementById('btn-' + type).classList.add('active');
            
            // Toggle Panels
            document.getElementById('card-crypto').style.display = (type === 'all' || type === 'crypto') ? 'block' : 'none';
            document.getElementById('card-stocks').style.display = (type === 'all' || type === 'stocks') ? 'block' : 'none';
            
            // Re-render editor logic
            updateEditorState();
            
            fetchData();
        }

        // Charts
        const commonOpts = { chart: { height: 250, toolbar: {show:false}, background: 'transparent' }, theme: { mode: 'dark' }, stroke: { curve: 'straight', width: 2 }, grid: { borderColor: '#334155' }, dataLabels: { enabled: false }, xaxis: { type: 'datetime' } };
        const eqChart = new ApexCharts(document.querySelector("#equityChart"), { ...commonOpts, chart: { ...commonOpts.chart, type: 'area'}, colors: ['#3b82f6'], series: [] });
        eqChart.render();
        const candleChart = new ApexCharts(document.querySelector("#candleChart"), { ...commonOpts, chart: { ...commonOpts.chart, type: 'candlestick'}, plotOptions: { candlestick: { colors: { upward: '#10b981', downward: '#ef4444' } } }, series: [] });
        candleChart.render();

        async function fetchData() {
            try {
                const res = await fetch('/api/data', { headers: getAuthHeader() });
                if (res.status === 401) { document.getElementById('system-msg').innerText = "AUTH REQUIRED"; return; }
                const data = await res.json();

                // 1. Config & Editor
                if (data.prompts) cachedPrompts = data.prompts;
                if (!document.getElementById('prompt-text').value && currentFilter !== 'all') updateEditorState();

                // 2. Dropdown
                updateDropdown(data.global_config);

                // 3. Statuses
                updateStatus(data);

                // 4. Data Tables
                updatePositions(data.positions);
                updateTrades(data.trades);
                updateAI(data.ai_logs);
                
                // 5. Equity Curve
                const eqRes = await fetch(`/api/equity?filter=${currentFilter}`, { headers: getAuthHeader() });
                const eqData = await eqRes.json();
                
                if(eqData.curve) eqChart.updateSeries([{ name: "Equity", data: eqData.curve.map(d => ({ x: d[0]*1000, y: d[1] })) }]);
                document.getElementById('eq-label').innerText = eqData.label || "Equity";
                
                const finalVal = eqData.curve.length ? eqData.curve[eqData.curve.length-1][1] : 0;
                const color = finalVal >= 0 ? "text-green-400" : "text-red-400";
                document.getElementById('total-equity').innerHTML = `<span class="${color}">$${finalVal.toFixed(2)}</span>`;

            } catch (e) { console.error(e); }
        }

        function updateDropdown(cfg) {
            const sel = document.getElementById("chart-select");
            const currentOpts = sel.options.length;
            if(currentOpts > 1 && sel.dataset.filter === currentFilter) return; 
            
            sel.innerHTML = '<option value="">Select Pair...</option>';
            sel.dataset.filter = currentFilter;
            
            let list = [];
            // Context Aware Chart Dropdown
            if(currentFilter === 'all') list = [...(cfg.kraken_pairs||[])]; 
            // Add Stocks if All OR Stocks selected
            if(currentFilter === 'all' || currentFilter === 'stocks') list = [...list, ...(cfg.ibkr_stocks||[])];
            
            // If Crypto only
            if(currentFilter === 'crypto') list = cfg.kraken_pairs || [];
            
            list.forEach(p => {
                const friendly = cfg.friendly_map[p] || p;
                const opt = document.createElement("option"); opt.value = p; opt.text = friendly; sel.appendChild(opt);
            });
        }

        function updateStatus(data) {
            // Crypto Status
            const sc = data.status_crypto || {};
            const dColor = sc.display_color || 'red';
            document.getElementById('crypto-indicator').className = `status-dot dot-${dColor}`;
            document.getElementById('crypto-mode').innerText = (sc.display_status || 'UNKNOWN');
            document.getElementById('crypto-status').innerText = sc.killed ? "KILLED" : (sc.paused ? "PAUSED" : "ACTIVE");
            
            // Stock Status
            const ss = data.status_stocks || {};
            const sMode = (ss.mode_config || 'PAPER').toUpperCase();
            document.getElementById('stocks-indicator').className = `status-dot ${ss.paused ? 'dot-yellow' : 'dot-green'}`;
            document.getElementById('stocks-mode').innerText = sMode;
            document.getElementById('stocks-count').innerText = ss.tickers || 0;
        }

        function updatePositions(positions) {
            const tbody = document.getElementById('positions-body');
            tbody.innerHTML = '';
            for (const [sym, pos] of Object.entries(positions)) {
                const type = pos.asset_type.toLowerCase();
                
                // Filtering (Strict matching for "stocks" vs "stock" typos)
                if (currentFilter !== 'all') {
                    if (currentFilter === 'stocks' && type !== 'stocks') continue;
                    if (currentFilter === 'crypto' && type !== 'crypto') continue;
                }
                
                const upnl = pos.unrealized_usd || 0;
                const pColor = upnl >= 0 ? "text-green-400" : "text-red-400";
                
                const modeStr = (pos.mode || 'UNK').toUpperCase();
                const modeClass = modeStr.includes("LIVE") && !modeStr.includes("LATCH") ? "text-red-500 font-bold" : "text-slate-400";

                tbody.innerHTML += `
                    <tr class="border-b border-slate-700">
                        <td class="py-2 font-bold text-white">${pos.friendly_name}</td>
                        <td class="py-2 text-xs ${modeClass}">${modeStr}</td>
                        <td class="py-2 font-mono">${parseFloat(pos.base_volume).toFixed(4)}</td>
                        <td class="py-2 font-mono text-slate-400">$${parseFloat(pos.average_price).toFixed(4)}</td>
                        <td class="py-2 font-mono text-white">$${(pos.current_value||0).toFixed(2)}</td>
                        <td class="py-2 font-mono ${pColor}">$${upnl.toFixed(2)} (${pos.unrealized_pct.toFixed(2)}%)</td>
                    </tr>`;
            }
        }

        function updateTrades(trades) {
            const tbody = document.getElementById('trades-body');
            tbody.innerHTML = '';
            trades.slice().reverse().forEach(t => {
                // Infer type from pair if friendly_name missing or check generic logic
                const isCrypto = t.pair.includes("USD") || t.pair.includes("XBT");
                const type = isCrypto ? 'crypto' : 'stocks';
                
                if (currentFilter !== 'all') {
                    if (currentFilter === 'stocks' && type !== 'stocks') return;
                    if (currentFilter === 'crypto' && type !== 'crypto') return;
                }
                
                const color = t.side === 'buy' ? 'text-green-400' : 'text-red-400';
                tbody.innerHTML += `
                    <tr class="border-b border-slate-800 text-xs">
                        <td class="py-1 text-slate-400">${new Date(t.ts * 1000).toLocaleTimeString()}</td>
                        <td class="py-1 font-bold">${t.friendly_name}</td>
                        <td class="py-1 ${color} font-bold uppercase">${t.side}</td>
                        <td class="py-1 font-mono">$${parseFloat(t.price).toFixed(4)}</td>
                    </tr>`;
            });
        }

        function updateAI(logs) {
            const container = document.getElementById('ai-logs');
            container.innerHTML = '';
            logs.slice().reverse().forEach(log => {
                // Strict Filtering
                if (currentFilter !== 'all') {
                    if (currentFilter === 'stocks' && log.type !== 'stocks') return;
                    if (currentFilter === 'crypto' && log.type !== 'crypto') return;
                }

                const color = log.response.includes("GO") ? "text-green-400" : (log.response.includes("STOP") ? "text-red-400" : "text-slate-400");
                container.innerHTML += `
                    <div class="bg-slate-800 p-2 rounded border-l-2 border-slate-600 mb-2">
                        <div class="flex justify-between text-xs text-slate-500 mb-1">
                            <span>${new Date(log.ts * 1000).toLocaleTimeString()}</span>
                            <span class="text-blue-400 font-bold">${log.asset}</span>
                        </div>
                        <div class="text-xs ${color} whitespace-pre-wrap">${log.response}</div>
                    </div>`;
            });
        }
        
        function updateEditorState() {
            const txt = document.getElementById('prompt-text');
            const target = document.getElementById('prompt-target');
            const btn = document.getElementById('btn-save-prompt');
            
            if (currentFilter === 'all') {
                txt.value = ""; txt.disabled = true;
                txt.placeholder = "<< SELECT A BOT (CRYPTO OR STOCKS) ABOVE TO EDIT INSTRUCTIONS >>";
                target.innerText = "DISABLED";
                btn.disabled = true;
                btn.classList.add('opacity-50');
            } else if (currentFilter === 'crypto') {
                txt.disabled = false;
                txt.value = cachedPrompts.strategy_decision || "";
                target.innerText = "EDITING: ZEUS (Crypto)";
                btn.disabled = false;
                btn.classList.remove('opacity-50');
            } else {
                txt.disabled = false;
                txt.value = cachedPrompts.stock_swing_decision || "";
                target.innerText = "EDITING: SENTINEL (Stocks)";
                btn.disabled = false;
                btn.classList.remove('opacity-50');
            }
        }
        
        async function saveConfig() {
            let key = currentFilter === 'crypto' ? 'strategy_decision' : 'stock_swing_decision';
            await apiCall('/config/ai', { new_prompt: document.getElementById('prompt-text').value, target_key: key });
            alert("Instructions Updated");
        }
        
        async function loadCandles() {
            const p = document.getElementById("chart-select").value;
            if(!p) return;
            const res = await fetch(`/candles?pair=${p}`, { headers: getAuthHeader() });
            const d = await res.json();
            if(d.data) candleChart.updateSeries([{ data: d.data }]);
        }

        async function loadConfig() {
            const res = await fetch('/config/ai', { headers: getAuthHeader() });
            const d = await res.json();
            if(d.prompts) { cachedPrompts = d.prompts; updateEditorState(); }
        }

        setInterval(fetchData, 2000);
        loadConfig();
        fetchData();
    </script>
</body>
</html>
"""

@app.get("/ui", response_class=HTMLResponse)
def ui():
    return HTMLResponse(content=HTML_TEMPLATE)

@app.get("/")
def root():
    return HTMLResponse(content=HTML_TEMPLATE)